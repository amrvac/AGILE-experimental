
! doubleGEM3D -- cubic 3D AMR run, sized for 6 nodes (48 GCDs) on LUMI.
 &filelist
   base_filename    = 'output/doublegem3d'
   autoconvert      = F
   convert_type     = 'vtuBCCmpi'
   saveprim         = T
   typefilelog      = 'special'
 /

 &savelist
   itsave(1,1)      = 0
   itsave(1,2)      = 0
   itsave(1,6)      = 0
   dtsave_log       = 0.1d0
   dtsave_dat       = 100.d0     ! restart dumps; ~6 GB each at 63% fill
   dtsave_snap      = 20.0d0     ! 18 snapshots, ~6 GB each => ~110 GB total
 /

 &stoplist
   time_max = 350.0
 /

 &methodlist
   time_stepper    = 'threestep'
   flux_scheme     = 20*'hll'
   limiter         = 20*'koren'
   phys            = 'mhd'
 /

 &boundlist
   typeboundary_min1 = 8*'periodic'
   typeboundary_max1 = 8*'periodic'
   typeboundary_min2 = 8*'periodic'
   typeboundary_max2 = 8*'periodic'
   typeboundary_min3 = 8*'periodic'
   typeboundary_max3 = 8*'periodic'
 /

 &meshlist
   ! full refinement = 32768 blocks. At the 63% fill of run 20350385 that is
   ! ~20600 blocks = ~430/rank over 48 ranks
   max_blocks         = 800
   refine_max_level   = 4
   refine_usr         = .true.       ! forced sheet bands, only while t < t_force_sheet
   refine_criterion   = 3            ! 3 = Lohner error estimator
   ! Lohner weighted on rho (1), Bx (mag(1)=6), By (mag(2)=7)
   w_refine_weight(1) = 0.25d0
   w_refine_weight(6) = 0.375d0
   w_refine_weight(7) = 0.375d0
   ! default is 0.1 at every level
   refine_threshold(1) = 0.10d0
   refine_threshold(2) = 0.15d0
   refine_threshold(3) = 0.20d0
   refine_threshold(4) = 0.25d0
   block_nx1          = 16
   block_nx2          = 16
   block_nx3          = 16
   domain_nx1         = 64           ! level-1 dx = 0.469 in all three dims
   domain_nx2         = 64
   domain_nx3         = 64
   xprobmin1       = -15.0d0
   xprobmax1       = 15.0d0
   xprobmin2       = -15.0d0
   xprobmax2       = 15.0d0
   xprobmin3       = -15.0d0
   xprobmax3       = 15.0d0
 /

 &paramlist
   slowsteps        = 10
   courantpar       = 0.7d0
   typecourant      = 'maxsum'
 /

 &mhd_list
   mhd_gravity = .false.
   mhd_radiative_cooling = .false.
   mhd_source_usr = .false.
   mhd_resistivity = .true.
   mhd_eta=1.0d-3
 /

 &usr_list
   psi0bot=0.1d0
   psi0top=0.1d0
   seed     = 20360812
   ! RMS of v_y' in each sheet plane.
   pert_amp = 1.0d-3
   pert_wid = 1.0d0        ! sech^2 localisation width a (= sheetl)
   mode_root = 1           ! lowest (n,m) wavenumber
   n_modes   = 10          ! z-wavelengths L(3)/m = 30 down to 3, all well resolved
   ysh1      = -5.0d0
   ysh2      = 5.0d0
   sheet_hw      = 1.0d0
   t_force_sheet = 20.0d0  ! and only enforced up to this time
 /
